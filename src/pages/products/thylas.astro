---
import Base from '../../layouts/Base.astro';
import Sigil from '../../components/Sigil.astro';
import { site } from '../../data/site';

const capabilities = [
  {
    index: '01',
    title: 'Workspace & Files',
    status: 'In the build',
    body: 'The central object. Everything you open — a file, a note, a board, a run — lives inside a workspace scope, and the scope survives tabs, sessions and switching. File tree, table and preview are navigable; upload is not connected yet.',
  },
  {
    index: '02',
    title: 'Notes & Documents',
    status: 'In the build',
    body: 'Markdown-first knowledge management: [[wikilinks]], backlinks, autosave, conflict handling. Obsidian-inspired, minus the plugin market.',
  },
  {
    index: '03',
    title: 'Whiteboard',
    status: 'In the build',
    body: 'Spatial boards for thinking in parallel: cards, sections, edges, zoom to pointer, undo. Heptabase-inspired. A card can be authored — yours, editable — or live: owned by a run, read-only.',
  },
  {
    index: '04',
    title: 'Processes',
    status: 'In the build',
    body: 'The interface for delegated work: five states — queued · running · needs you · done · failed — filters, and a run detail view. Today it runs on a labelled simulator; the view is built to be fed by WAM.',
  },
  {
    index: '05',
    title: 'AI',
    status: 'In the build',
    body: 'One capability, done honestly: a question answered by DeepSeek through a server-side endpoint, labelled DeepSeek · dev endpoint. It answers; it never pretends to start a process.',
  },
  {
    index: '06',
    title: 'WAM',
    status: 'Deferred',
    body: 'Deep integration is the point of the architecture, not part of the current build. The transport is the open problem, and it is named as one.',
  },
];

const refusals = [
  {
    title: 'Not a productivity workspace',
    because:
      'In Notion or Heptabase, every object was made by a person. Thylas has a second class: work delegated elsewhere, with a lifecycle nobody controls — it can change while you are not looking.',
    instead:
      'State is a first-class element. A running job is never visually indistinguishable from a finished note.',
  },
  {
    title: 'Not a chat product',
    because:
      'Chat orders everything by time and dies with the session. The conversation is a good input method and a bad organising principle.',
    instead:
      'Intent is taken as text, then filed as an object. The record is the plan and the artifacts, not the transcript.',
  },
  {
    title: 'Not a cloud console',
    because:
      'A console reports on the provider’s resources. Thylas answers a different question: did your work move forward, and what needs you.',
    instead: 'Overview orients; cost lives in Account, one click away.',
  },
];

const principles = [
  {
    index: 'P·1',
    title: 'Continuity',
    body: 'Every boundary is a 1px line that runs the full length of its region. Raised surfaces are lighter; recessed are darker. Never the reverse.',
  },
  {
    index: 'P·2',
    title: 'Structure',
    body: 'A 4px grid, seven type steps, one accent reserved for state. Hue never encodes structure: remove all colour and the layout still reads.',
  },
  {
    index: 'P·3',
    title: 'Agency',
    body: 'The material is yours. Authored objects are editable; delegated objects are read-only until they land. The interface reports state instead of making decisions.',
  },
];

const stages = [
  {
    title: 'Working today',
    status: 'In the build',
    items: [
      'Application shell — rail, typed tabs with persistence, context panel, ⌘K palette, per-workspace restore',
      'Notes — Markdown source, [[wikilinks]], backlinks, idle save, conflict review, dirty guard',
      'Whiteboard — cards, sections, edges, pointer-anchored zoom, 24px targets at any zoom',
      'Processes — five states, URL filters, labelled simulator; AI panel behind a server-side path',
    ],
  },
  {
    title: 'In development',
    status: 'Active',
    items: [
      'Visual quality pass — radius, typeface, icons, surface, control states',
      'Composition of the list surfaces: boards, processes, overview at 1440',
      'Context chip on the AI panel; compressed trace on the run view',
    ],
  },
  {
    title: 'Not started',
    status: 'Planned',
    items: [
      'Account surface and preferences',
      'Integration gates and the final cross-surface audit',
      'File upload and storage; authentication and organisation membership — the authorization model is open (N2)',
    ],
  },
  {
    title: 'Deferred',
    status: 'Deferred',
    items: [
      'WAM integration — transport unresolved (N1)',
      'Billing, quotas, invoicing · real-time collaboration · mobile',
    ],
  },
];
---

<Base
  title="Thylas"
  section="Application Layer"
  description="Thylas is CHORD’s application layer: a computational workspace for human-AI collaboration — persistent workspaces, Markdown notes, spatial whiteboards, and the interface for delegated work."
>
  <!-- 01 — Hero -->
  <section class="hero">
    <div class="shell hero__grid">
      <div class="hero__copy">
        <p class="hero__eyebrow">
          <span>CHORD</span>
          <span class="hero__sep" aria-hidden="true">·</span>
          <span class="hero__sigil"><Sigil slug="thylas" size={15} weight={12} /></span>
          <span class="hero__sep" aria-hidden="true">·</span>
          <span>Application layer</span>
        </p>

        <h1 class="hero__title">
          A computational workspace for human&#8209;AI collaboration<span class="hero__dot">.</span>
        </h1>

        <p class="hero__lede">
          Thylas is where your material, the work you do on it, and the work you hand to the
          system sit in the same room. It is CHORD’s application layer: an organized,
          persistent environment for knowledge, resources, and computational work.
        </p>

        <div class="hero__actions">
          <a class="btn btn--solid" href="#workspace">
            What it does today
            <span class="btn__arrow" aria-hidden="true">↓</span>
          </a>
          <a class="btn" href="#architecture">
            How it fits CHORD
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <p class="hero__status">UI MVP in progress · shell live, data sample · 2026-11</p>
      </div>

      <figure class="hero__figure">
        <div
          class="board"
          role="img"
          aria-label="Schematic of a Thylas workspace: an intent line entering from the left, passing a file card, a note card and a board section, and ending at a live, read-only card produced by run 12."
        >
          <span class="board__label">Workspace · research-papers</span>
          <div class="intent"><span>intent →</span></div>

          <div class="scard scard--file">
            <span class="scard__k">File</span>
            <span class="scard__v">survey-2026.pdf</span>
            <span class="scard__m">PDF · 2.1 MB</span>
          </div>

          <div class="scard scard--note">
            <span class="scard__k">Note</span>
            <span class="scard__v">contradictions.md</span>
            <span class="scard__m">[[claim-3]] · backlinks 4</span>
          </div>

          <div class="scard scard--section">
            <span class="scard__k">Section</span>
            <span class="scard__v">Related work</span>
            <span class="scard__m">6 cards</span>
          </div>

          <div class="scard scard--live">
            <span class="scard__k"><span class="scard__dot"></span>Live · read-only</span>
            <span class="scard__v">Weakest-support claim</span>
            <span class="scard__m">produced by run #12</span>
          </div>
        </div>
        <figcaption class="hero__caption">
          <span>Fig. τ</span>
          <span>Material, a note, a section, and a card that arrived from a run</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 02 — The workspace -->
  <section class="section" id="workspace">
    <div class="shell">
      <header class="thead">
        <span class="thead__index">02</span>
        <div>
          <h2 class="thead__title">The workspace</h2>
          <p class="thead__lede">
            Five areas, because there are five things a person does here: orient, organise,
            think, delegate, administer. Each is labelled with what it is today — not with
            what it is meant to become.
          </p>
        </div>
      </header>

      <div class="caps">
        {
          capabilities.map((cap) => (
            <article class="cap">
              <span class="cap__index">{cap.index}</span>
              <div class="cap__head">
                <h3 class="cap__title">{cap.title}</h3>
                <span class="chip">{cap.status}</span>
              </div>
              <p class="cap__body">{cap.body}</p>
            </article>
          ))
        }
      </div>

      <p class="honesty">
        The shell is real. The data is sample data. Nothing on this page is a screenshot.
      </p>
    </div>
  </section>

  <!-- 03 — Beyond a conventional workspace -->
  <section class="section">
    <div class="shell">
      <header class="thead">
        <span class="thead__index">03</span>
        <div>
          <h2 class="thead__title">Beyond a conventional workspace</h2>
          <p class="thead__lede">
            Thylas is built against three products it refuses to be. Each refusal decides
            something concrete about the interface.
          </p>
        </div>
      </header>

      <div class="refusals">
        {
          refusals.map((item) => (
            <article class="refusal">
              <h3 class="refusal__title">{item.title}</h3>
              <p class="refusal__because">{item.because}</p>
              <p class="refusal__instead">{item.instead}</p>
            </article>
          ))
        }
      </div>

      <p class="pull">
        And one thing none of them have: provenance. Every artifact carries which run
        produced it — and removing a file breaks the things that reference it.
      </p>
    </div>
  </section>

  <!-- 04 — Architecture -->
  <section class="section" id="architecture">
    <div class="shell">
      <header class="thead">
        <span class="thead__index">04</span>
        <div>
          <h2 class="thead__title">Architecture</h2>
          <p class="thead__lede">
            The distinction is not “UI versus backend”. It is which state each component is
            the authority for.
          </p>
        </div>
      </header>

      <div class="own">
        <div class="own__col">
          <h3 class="own__title">Thylas owns — working state</h3>
          <ul role="list">
            <li>Which workspace, what is open</li>
            <li>Where a note lives, what a board looks like</li>
            <li>What you named things, what you have seen</li>
            <li>Files, notes, boards, preferences, open tabs</li>
          </ul>
        </div>
        <div class="own__mid" aria-hidden="true"></div>
        <div class="own__col">
          <h3 class="own__title">WAM owns — reasoning state</h3>
          <ul role="list">
            <li>What the intent means</li>
            <li>What the plan is, and its revisions</li>
            <li>Which agent is running, what is shared across sessions</li>
            <li>Run state, scheduling, retry, model choice</li>
          </ul>
        </div>
      </div>

      <p class="pull">
        If a Thylas screen has to decide something about your work, the screen is wrong.
        Thylas collects the instruction, WAM decides, Thylas reports.
      </p>

      <p class="archfoot">
        <strong>Position within CHORD:</strong> WAM is the orchestration layer and Thylas’s future
        counterpart — not connected yet. Rym, the model layer, is called by WAM, never by
        Thylas. Knock is the community, out of scope by decision, linked at most.
      </p>
    </div>
  </section>

  <!-- 05 — Design philosophy -->
  <section class="section section--invert philosophy">
    <div class="shell">
      <header class="thead">
        <span class="thead__index">05</span>
        <div>
          <h2 class="thead__title">Design philosophy</h2>
          <p class="thead__lede">
            The product is built as an instrument, not a dashboard. Three principles carry
            most of that weight.
          </p>
        </div>
      </header>

      <div class="principles">
        {
          principles.map((item) => (
            <article class="principle">
              <span class="principle__index">{item.index}</span>
              <h3 class="principle__title">{item.title}</h3>
              <p class="principle__body">{item.body}</p>
            </article>
          ))
        }
      </div>

      <p class="pull pull--invert">
        The one-sentence test: cover the logo. If the surface could be mistaken for
        project-management SaaS, something on it is generic.
      </p>
    </div>
  </section>

  <!-- 06 — Development -->
  <section class="section">
    <div class="shell">
      <header class="thead">
        <span class="thead__index">06</span>
        <div>
          <h2 class="thead__title">Development</h2>
          <p class="thead__lede">
            The state of the repository, dated 2026-11-09. Stated as the repo states it — if
            this table and the build disagree, the build wins.
          </p>
        </div>
      </header>

      <div class="stages">
        {
          stages.map((stage) => (
            <article class="stage">
              <div class="stage__head">
                <h3 class="stage__title">{stage.title}</h3>
                <span class="chip">{stage.status}</span>
              </div>
              <ul class="stage__list" role="list">
                {stage.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <p class="openfoot">
        Open before implementation: N1 WAM transport · N2 who owns authentication · N5 whether
        the browser can reach WAM directly. They block screens, not documents.
      </p>
    </div>
  </section>

  <!-- 07 — Closing -->
  <section class="section closing">
    <div class="shell">
      <p class="label closing__label">07 · Closing</p>
      <h2 class="closing__statement">
        The workspace is the product. The rest of CHORD is what makes it computable.
      </h2>
      <div class="closing__links">
        <a class="link-arrow" href="/products/wam">WAM — orchestration</a>
        <a class="link-arrow" href="/research">Research</a>
        <a class="link-arrow" href={site.github} target="_blank" rel="noopener">GitHub ↗</a>
        <a class="link-arrow" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ==========================================================================
     01 — Hero
     ========================================================================== */

  .hero {
    display: grid;
    align-items: center;
    min-height: min(76vh, 44rem);
    padding-block: clamp(2.25rem, 4.5vw, 4rem) clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: var(--hairline);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3.5rem);
    align-items: center;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--taupe);
  }

  .hero__sep {
    color: var(--terracotta);
  }

  .hero__sigil {
    color: var(--terracotta);
    display: inline-flex;
  }

  .hero__title {
    margin-block: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1.25rem, 2vw, 1.5rem);
    font-size: clamp(2.4rem, 1rem + 4.4vw, 4.4rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.045em;
    max-width: 18ch;
  }

  .hero__dot {
    color: var(--terracotta);
  }

  .hero__lede {
    max-width: 56ch;
    font-size: clamp(1rem, 0.94rem + 0.35vw, 1.1875rem);
    line-height: 1.58;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
  }

  .hero__status {
    margin-top: 1.75rem;
    padding-top: 0.75rem;
    border-top: var(--hairline);
    max-width: 26rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--taupe);
  }

  .hero__figure {
    margin: 0;
  }

  /* Board schematic — the three-construction system, object 2 */
  .board {
    position: relative;
    aspect-ratio: 1.18 / 1;
    background-color: var(--th-paper);
    background-image: radial-gradient(var(--th-dot) 1px, transparent 1.4px);
    background-size: 16px 16px;
    border: 1px solid var(--th-line-strong);
  }

  .board__label {
    position: absolute;
    left: 16px;
    top: 14px;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--taupe);
  }

  .intent {
    position: absolute;
    left: 0;
    top: 50%;
    width: 42%;
    height: 1px;
    background: var(--ink);
  }

  .intent span {
    position: absolute;
    left: 8px;
    top: -1.5rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--th-ink-2);
  }

  .scard {
    position: absolute;
    display: flex;
    flex-direction: column;
    min-width: 8.5rem;
    padding: 0.6rem 0.75rem;
    background: var(--th-surface);
    border: 1px solid var(--th-line-strong);
  }

  .scard--file {
    left: 40%;
    top: 13%;
  }

  .scard--note {
    left: 36%;
    top: 54%;
  }

  .scard--section {
    left: 64%;
    top: 30%;
  }

  .scard--live {
    left: 62%;
    top: 72%;
    border-left: 2px solid var(--terracotta);
  }

  .scard__k {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--taupe);
    margin-bottom: 0.3rem;
  }

  .scard__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--terracotta);
    flex: none;
  }

  .scard__v {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .scard__m {
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--th-ink-2);
  }

  .hero__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.6rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--th-line);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    color: var(--taupe);
  }

  .hero__caption span:first-child {
    white-space: nowrap;
  }

  /* ==========================================================================
     Section furniture
     ========================================================================== */

  .thead {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    margin-bottom: clamp(2rem, 3.5vw, 3rem);
  }

  .thead__index {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    color: var(--terracotta);
    padding-top: 0.5em;
  }

  .thead__title {
    font-size: clamp(1.9rem, 1.2rem + 2.4vw, 2.9rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.04em;
    margin-bottom: 0.85rem;
    max-width: 18ch;
  }

  .thead__lede {
    max-width: 58ch;
    font-size: 1rem;
    line-height: 1.62;
    color: var(--ink-soft);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    border: 1px solid var(--rule);
    padding: 0.3rem 0.5rem;
    white-space: nowrap;
  }

  .chip::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--terracotta);
    flex: none;
  }

  .pull {
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
    padding: 1rem 1.5rem;
    border-left: 2px solid var(--terracotta);
    font-size: clamp(1.05rem, 0.95rem + 0.6vw, 1.375rem);
    font-weight: 600;
    line-height: 1.42;
    letter-spacing: -0.02em;
    max-width: 62ch;
  }

  /* ==========================================================================
     02 — Capabilities
     ========================================================================== */

  .caps {
    border-top: var(--hairline-strong);
  }

  .cap {
    display: grid;
    grid-template-columns: 3.5rem minmax(13rem, 0.85fr) minmax(0, 1.45fr);
    gap: clamp(1rem, 2.4vw, 2.5rem);
    padding-block: clamp(1.5rem, 2.6vw, 2rem);
    border-bottom: var(--hairline);
    align-items: start;
  }

  .cap__index {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    color: var(--taupe);
    padding-top: 0.4rem;
  }

  .cap__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .cap__title {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.05;
  }

  .cap__body {
    font-size: 0.9375rem;
    line-height: 1.66;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .honesty {
    margin-top: clamp(2rem, 3vw, 2.5rem);
    padding-block: 0.9rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* ==========================================================================
     03 — Refusals
     ========================================================================== */

  .refusals {
    border-top: var(--hairline-strong);
  }

  .refusal {
    display: grid;
    grid-template-columns: minmax(12rem, 0.8fr) minmax(0, 1.2fr) minmax(0, 1.2fr);
    gap: clamp(1rem, 2.4vw, 2.5rem);
    padding-block: clamp(1.5rem, 2.6vw, 2rem);
    border-bottom: var(--hairline);
    align-items: start;
  }

  .refusal__title {
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .refusal__because {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .refusal__instead {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink);
    padding-left: 1.25rem;
    border-left: 2px solid var(--terracotta);
  }

  /* ==========================================================================
     04 — Ownership
     ========================================================================== */

  .own {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 3.5rem);
    align-items: stretch;
    border-top: var(--hairline-strong);
    padding-top: clamp(1.25rem, 2vw, 1.75rem);
  }

  .own__col {
    background: var(--th-surface);
    border: 1px solid var(--th-line-strong);
    padding: clamp(1.1rem, 2vw, 1.5rem);
  }

