---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';

const workAreas = [
  {
    index: 'W/01',
    title: 'Agents that stay with a problem.',
    body: 'A paper, a product, a competition run — these do not fit inside one session. The hard failure is rarely a bad answer; it is a lost thread. WAM is built around shared context, plans revised against what actually happened, and execution that produces something checkable. Thylas is the workspace where that work sits.',
    question: 'What should persist between two conversations about the same problem?',
    grounded:
      'WAM · Shared context (R/04) · Dynamic planning (R/03) · Agent infrastructure (R/01) · Thylas · Autonomous research and collaborative development — both research programs',
    guard: 'WAM is the core framework. Thylas is a UI MVP in progress. Sustained work is a direction, not a shipped capability.',
  },
  {
    index: 'W/02',
    title: 'When something works once, make it usable again.',
    body: 'A successful trajectory contains structure: a step that can be named, bounded, checked, and run again. The Operator Paradigm — discover, abstract, compose, generalize — is our working concept for extracting it. It is a research direction. We do not claim a general operator library exists.',
    question: 'When a complex operation succeeds once, what exactly can be reused?',
    grounded:
      'Operator Paradigm · Reusable operators (R/06) · Computational cognition (R/05) · WAM scheduling core',
    guard: 'An ongoing technical direction, with no formal definition and no operator library.',
  },
  {
    index: 'W/03',
    title: 'Define the operation, then build the model for it.',
    body: 'Much of an agent’s day is a small number of operations repeated. Rym asks whether a compact model built for one defined operation can perform it more precisely and cheaply than a general model invoked for everything. The boundary comes first; the model is built to satisfy it. Rym is a research direction, not a released model family.',
    question: 'How small can a model be and still perform a specialized operation reliably?',
    grounded:
      'Rym · Small language models (R/02) · Computational cognition (R/05) · WAM operator boundaries',
    guard: 'No benchmark comparisons or parameter counts are published.',
  },
];

const pathways = [
  {
    index: 'P/01',
    title: 'Core Builders',
    forWhom: 'People who want to stay with one system long enough to be accountable for how it turns out.',
    contribute:
      'Architecture decisions, an implementation of a layer, the discipline of keeping a system honest about its own state.',
    looksLike:
      'A sustained piece of work on WAM, Thylas, Rym, or the infrastructure underneath them — with the context that these are projects at different stages, not a finished platform.',
    primary: { label: 'Start with what exists', href: '/developers' },
    secondary: { label: 'How to reach CHORD', href: '/contact' },
    guard: 'We do not publish open positions on this page.',
  },
  {
    index: 'P/02',
    title: 'Research Collaborators',
    forWhom:
      'People who want to investigate one question properly rather than join a broad programme.',
    contribute:
      'A sharper question, a falsifiable experiment, a negative result, a careful reading of work already done.',
    looksLike:
      'A bounded collaboration on one of the six research directions, or on the Operator Paradigm. Results appear when they can be defended; the publications index is deliberately empty today.',
    primary: { label: 'Read the six questions', href: '/research' },
    secondary: { label: 'Read the working concept', href: '/#operators' },
  },
  {
    index: 'P/03',
    title: 'Open-source Contributors',
    forWhom: 'People who prefer to start with something concrete and public.',
    contribute:
      'Code, tests, documentation, a reproduction, a review, or a well-formed issue that makes a problem easier to see.',
    looksLike:
      'Work in the public GitHub organization’s repositories. Read each repository’s own guidance first; where a repository has none, open an issue describing what you intend to change and why. A short issue costs less than a large pull request that has to be redirected.',
    primary: { label: 'Developers', href: '/developers' },
    external: { label: 'GitHub organization ↗', href: site.github },
  },
  {
    index: 'P/04',
    title: 'Independent Explorers',
    forWhom:
      'People with a question, an idea, or a perspective that does not fit any of the categories above.',
    contribute:
      'The question itself. A different framing of a problem we have been looking at from one side. A critique.',
    looksLike:
      'A first message that says what you are trying to do, what you have tried, and what a good outcome would look like. That is enough to start a conversation; it is not an application and we cannot promise a reply time.',
    primary: { label: 'How to reach CHORD', href: '/contact' },
    secondary: { label: 'Email', href: `mailto:${site.email}` },
  },
];
---

<Base
  title="Join"
  description="There is meaningful, unfinished technical work at CHORD. Three open areas, four ways to participate, and one honest channel to start a conversation."
>
  <!-- 00 — The invitation -->
  <section class="join-hero">
    <div class="shell join-hero__grid">
      <div class="join-hero__copy">
        <p class="label join-hero__eyebrow">CHORD · Join</p>
        <h1 class="join-hero__title">
          The interesting parts are not finished<span class="join-hero__dot">.</span>
        </h1>
        <p class="join-hero__lede">
          CHORD is an AI infrastructure company building for agents that can sustain complex work.
          Most of that is still open: the questions, the abstractions, and the systems that would
          make them real. If a question here is yours too, there are several ways to start.
        </p>
        <div class="join-hero__actions">
          <a class="btn btn--solid" href="#work">
            See the open work
            <span class="btn__arrow" aria-hidden="true">↓</span>
          </a>
          <a class="btn" href="#participate">
            Ways to participate
            <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </div>
        <p class="mono-note join-hero__callback">
          The homepage describes where CHORD is going. This page is about the parts that are still
          open. <a href="/">chord-ai-org.github.io</a>
        </p>
      </div>

      <figure class="join-hero__figure">
        <svg
          class="open-ring"
          viewBox="0 0 480 480"
          role="img"
          aria-label="Three open concentric rings with a gap in each and three small square nodes, representing unfinished work."
        >
          <g stroke="var(--rule-strong)" stroke-width="1" fill="none">
            <path d="M240 26 V454 M26 240 H454" />
            <circle cx="240" cy="240" r="212" />
          </g>
          <g fill="none" stroke="var(--ink)" stroke-width="2.2" stroke-linecap="butt">
            <circle
              cx="240"
              cy="240"
              r="168"
              stroke-dasharray="925 130"
              transform="rotate(-104 240 240)"
            />
            <circle
              cx="240"
              cy="240"
              r="128"
              stroke-dasharray="700 105"
              transform="rotate(-32 240 240)"
              opacity="0.72"
            />
            <circle
              cx="240"
              cy="240"
              r="88"
              stroke-dasharray="470 83"
              transform="rotate(-158 240 240)"
              opacity="0.48"
            />
          </g>
          <g fill="var(--terracotta)">
            <rect x="382" y="104" width="9" height="9" />
            <rect x="96" y="330" width="7" height="7" />
            <rect x="312" y="388" width="6" height="6" />
          </g>
          <g fill="var(--ink)" opacity="0.55">
            <rect x="240" y="72" width="4" height="4" />
            <rect x="112" y="240" width="4" height="4" />
            <rect x="368" y="240" width="4" height="4" />
            <rect x="240" y="408" width="4" height="4" />
          </g>
          <circle cx="240" cy="240" r="7" fill="var(--terracotta)" />
        </svg>
        <figcaption class="join-hero__caption">
          <span>Fig. 03</span>
          <span>Three open areas. None of them closed.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 01 — The open work -->
  <section class="section" id="work" aria-labelledby="work-title">
    <div class="shell">
      <SectionHead
        index="01"
        title="Three areas. None of them finished."
        note="These are the questions CHORD is organized around. They are directions and experiments, not completed capabilities. Start with the one you can already ask a better question about."
        id="work-title"
      />

      <div class="work">
        {
          workAreas.map((area) => (
            <article class="work-row">
              <span class="work-row__index">{area.index}</span>
              <div class="work-row__head">
                <h3 class="work-row__title">{area.title}</h3>
                <p class="work-row__question">{area.question}</p>
              </div>
              <div class="work-row__body">
                <p>{area.body}</p>
                <p class="work-row__grounded">{area.grounded}</p>
                <p class="work-row__guard">{area.guard}</p>
              </div>
            </article>
          ))
        }
      </div>

      <div class="status-strip">
        <p class="label">What exists today</p>
        <p class="mono-note">
          Thylas (UI MVP in progress) · WAM (core framework) · Rym (research direction) · Knock (in
          development). A public GitHub organization with repositories and issues. No publications
          yet.
        </p>
        <div class="status-strip__links">
          <a class="link-arrow" href="/about">About CHORD</a>
          <a class="link-arrow" href="/research">Research</a>
          <a class="link-arrow" href="/developers">Developers</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 — Ways to participate -->
  <section class="section" id="participate" aria-labelledby="participate-title">
    <div class="shell">
      <SectionHead
        index="02"
        title="Four ways in. None of them is a job application."
        note="Participation does not require a posted role, a title, or an invitation. It starts with a question, an artifact, or a conversation."
        id="participate-title"
      />

      <div class="relationship">
        <p>
          These are ways of working with CHORD, not positions. The same person can enter through
          more than one.
        </p>
      </div>

      <div class="paths">
        {
          pathways.map((path) => (
            <article class="path">
              <div class="path__head">
                <span class="path__index">{path.index}</span>
                <h3 class="path__title">{path.title}</h3>
              </div>
              <dl class="path__fields">
                <div>
                  <dt>For</dt>
                  <dd>{path.forWhom}</dd>
                </div>
                <div>
                  <dt>Might contribute</dt>
                  <dd>{path.contribute}</dd>
                </div>
                <div>
                  <dt>What it could look like</dt>
                  <dd>{path.looksLike}</dd>
                </div>
              </dl>
              <div class="path__actions">
                <a class="link-arrow" href={path.primary.href}>{path.primary.label}</a>
                {path.secondary && <a class="link-arrow path__secondary" href={path.secondary.href}>{path.secondary.label}</a>}
                {path.external && (
                  <a class="link-arrow path__secondary" href={path.external.href} target="_blank" rel="noopener">
                    {path.external.label} <span class="path__external">External</span>
                  </a>
                )}
              </div>
              {path.guard && <p class="path__guard">{path.guard}</p>}
            </article>
          ))
        }
      </div>

      <p class="honesty">
        There is no application form on this page. Email and the GitHub organization are the
        channels that reach us today.
      </p>
    </div>
  </section>

  <!-- 03 — Closing -->
  <section class="section section--invert closing" aria-labelledby="closing-title">
    <div class="shell">
      <p class="label">03 · Closing</p>
      <h2 class="closing__statement" id="closing-title">
        The work is unfinished. That is the reason to start now.
      </h2>
      <p class="lede closing__line">
        Bring a question, an artifact, or a piece of work you want to stay with.
      </p>
      <div class="closing__links">
        <a class="link-arrow" href="/contact">How to reach CHORD</a>
        <a class="link-arrow" href={`mailto:${site.email}`}>Email</a>
        <a class="link-arrow" href={site.github} target="_blank" rel="noopener">GitHub ↗ External</a>
        <a class="link-arrow" href="/">Back to the homepage</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ==========================================================================
     00 — Hero
     ========================================================================== */

  .join-hero {
    display: grid;
    align-items: center;
    min-height: min(76vh, 44rem);
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: var(--hairline);
  }

  .join-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3.5rem);
    align-items: center;
  }

  .join-hero__eyebrow {
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  .join-hero__title {
    font-size: clamp(2.75rem, 1rem + 5.4vw, 5.25rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.05em;
    max-width: 16ch;
    margin-bottom: clamp(1.25rem, 2vw, 1.75rem);
  }

  .join-hero__dot {
    color: var(--terracotta);
  }

  .join-hero__lede {
    max-width: 54ch;
    font-size: clamp(1rem, 0.94rem + 0.35vw, 1.1875rem);
    line-height: 1.58;
    color: var(--ink-soft);
  }

  .join-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  .join-hero__callback {
    margin-top: 2rem;
    padding-top: 0.85rem;
    border-top: var(--hairline);
    max-width: 34rem;
  }

  .join-hero__callback a {
    color: var(--ink);
    border-bottom: 1px solid var(--rule-strong);
  }

  .join-hero__figure {
    margin: 0;
    min-width: 0;
  }

  .open-ring {
    width: 100%;
    height: auto;
    display: block;
  }

  .join-hero__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
    padding-top: 0.6rem;
    border-top: var(--hairline);
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    color: var(--taupe);
  }

  .join-hero__caption span:first-child {
    white-space: nowrap;
  }

  /* ==========================================================================
     01 — The open work
     ========================================================================== */

  .work {
    border-top: var(--hairline-strong);
  }

  .work-row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 0.95fr) minmax(0, 1.35fr);
    gap: clamp(1rem, 2.4vw, 2.75rem);
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    border-bottom: var(--hairline);
    align-items: start;
  }

  .work-row__index {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    color: var(--terracotta);
    padding-top: 0.4rem;
  }

  .work-row__title {
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.9rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .work-row__question {
    font-size: 0.9375rem;
    line-height: 1.55;
    font-weight: 500;
    color: var(--ink);
    padding-left: 1rem;
    border-left: 2px solid var(--terracotta);
    max-width: 32ch;
  }

  .work-row__body p {
    font-size: 0.9375rem;
    line-height: 1.68;
    color: var(--ink-soft);
    max-width: 58ch;
  }

  .work-row__grounded {
    margin-top: 1.1rem;
    font-family: var(--font-mono) !important;
    font-size: var(--step--2) !important;
    line-height: 1.8 !important;
    letter-spacing: 0.02em;
    color: var(--ink-soft) !important;
  }

  .work-row__guard {
    margin-top: 0.5rem;
    font-family: var(--font-mono) !important;
    font-size: var(--step--2) !important;
    line-height: 1.7 !important;
    color: var(--terracotta-deep) !important;
  }

  .status-strip {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 0.75rem clamp(1rem, 2.5vw, 2.5rem);
    margin-top: clamp(2rem, 3.5vw, 3rem);
    padding-top: 1.25rem;
    border-top: var(--hairline-strong);
  }

  .status-strip__links {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 0.75rem;
  }

  /* ==========================================================================
     02 — Ways to participate
     ========================================================================== */

  .relationship {
    padding-block: 1rem;
    border-top: var(--hairline);
    border-bottom: var(--hairline);
  }

  .relationship p {
    max-width: 62ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: var(--hairline-strong);
    border-left: var(--hairline);
    margin-top: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  .path {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.25rem, 2.2vw, 2rem);
    border-right: var(--hairline);
    border-bottom: var(--hairline);
  }

  .path__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .path__index {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    color: var(--terracotta);
  }

  .path__title {
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .path__fields {
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }

  .path__fields dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 0.2rem;
  }

  .path__fields dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.62;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .path__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .path__secondary {
    color: var(--taupe);
    border-bottom-color: var(--rule);
  }

  .path__external {
    color: var(--taupe);
    margin-left: 0.25rem;
  }

  .path__guard {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.02em;
    line-height: 1.7;
    color: var(--terracotta-deep);
    border-top: var(--hairline);
    padding-top: 0.6rem;
  }

  .honesty {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    padding-block: 0.9rem;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1.8;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-align: center;
  }

  /* ==========================================================================
     03 — Closing
     ========================================================================== */

  .closing__statement {
    margin-top: 1.25rem;
    font-size: clamp(1.9rem, 1.1rem + 3vw, 3.4rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.04em;
    max-width: 24ch;
  }

  .closing__line {
    margin-top: 1.5rem;
    max-width: 54ch;
  }

  .closing__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* ==========================================================================
     Responsive
     ========================================================================== */

  @media (max-width: 1080px) {
    .work-row {
      grid-template-columns: 3.5rem minmax(0, 0.9fr) minmax(0, 1.25fr);
    }
  }

  @media (max-width: 920px) {
    .join-hero__grid {
      grid-template-columns: 1fr;
    }
    .join-hero__figure {
      max-width: 26rem;
      margin-inline: auto;
    }
    .work-row {
      grid-template-columns: 3rem minmax(0, 1fr);
      grid-template-areas:
        'index head'
        'body body';
      row-gap: 1rem;
    }
    .work-row__index {
      grid-area: index;
    }
    .work-row__head {
      grid-area: head;
    }
    .work-row__body {
      grid-area: body;
    }
    .status-strip {
      grid-template-columns: 1fr;
    }
    .status-strip__links {
      grid-column: 1;
    }
    .paths {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .join-hero__caption {
      flex-direction: column;
      gap: 0.25rem;
    }
    .path {
      padding: 1.25rem 1rem;
    }
    .path__head {
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
