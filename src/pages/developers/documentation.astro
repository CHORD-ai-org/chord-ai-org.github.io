---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { site } from '../../data/site';

const planned = [
  {
    index: '01',
    label: 'WAM concepts',
    detail: 'Shared context, dynamic planning, and verifiable execution — what each one is responsible for, and where the boundaries sit.',
  },
  {
    index: '02',
    label: 'Operator definitions',
    detail: 'How an operator is described: inputs, invariants, and the condition under which its result is wrong.',
  },
  {
    index: '03',
    label: 'Thylas workspace model',
    detail: 'Workspaces, artifacts, task state, and how a personal workspace relates to an organization.',
  },
  {
    index: '04',
    label: 'Rym interface',
    detail: 'The boundary between the framework and the model layer — published only once the research direction stabilises.',
  },
];
---

<Base
  title="Documentation"
  description="CHORD documentation is not published yet. This page describes what will be documented and why there are no placeholder docs in the meantime."
>
  <PageHeader
    eyebrow="Developers / 02"
    title="Documentation"
    lede="Not published yet. This page is a commitment about what will be here, not a preview of it."
  />

  <div class="shell">
    <div class="notice">
      <p class="notice__statement">Nothing to read yet.</p>
      <div class="notice__body">
        <p>
          Documentation for WAM, Thylas, and Rym is in preparation. We are not publishing
          placeholder pages with headings and empty sections — a documentation site that
          looks complete and says nothing is worse than an honest gap.
        </p>
        <p>
          In the meantime, the repositories on
          <a class="text-link" href={site.github} target="_blank" rel="noopener">GitHub</a>
          are the most accurate description of what exists.
        </p>
      </div>
    </div>

    <section class="planned" aria-labelledby="planned-title">
      <h2 class="label" id="planned-title">Planned sections</h2>
      <ul class="planned__list" role="list">
        {
          planned.map((item) => (
            <li class="planned__row">
              <span class="planned__index">{item.index}</span>
              <span class="planned__label">{item.label}</span>
              <span class="planned__detail">{item.detail}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="foot">
      <a class="link-arrow" href="/developers">
        <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M13 5H2M6 1L2 5l4 4" stroke="currentColor" stroke-width="1.4" />
        </svg>
        Developers overview
      </a>
    </div>
  </div>
</Base>

<style>
  .notice {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(2rem, 4vw, 3.5rem);
    border-bottom: var(--hairline);
  }

  .notice__statement {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1rem + 4vw, 4.25rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .notice__body {
    display: grid;
    gap: 1em;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 54ch;
    padding-top: 0.35rem;
  }

  .planned {
    padding-block: clamp(2.5rem, 4vw, 3.5rem);
    border-bottom: var(--hairline);
  }

  .planned__list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: var(--hairline);
  }

  .planned__row {
    display: grid;
    grid-template-columns: 3.5rem minmax(9rem, 0.8fr) minmax(0, 1.7fr);
    gap: clamp(1rem, 2vw, 2rem);
    padding-block: 1rem;
    border-bottom: var(--hairline);
    align-items: baseline;
  }

  .planned__index {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    color: var(--terracotta);
    letter-spacing: 0.1em;
  }

  .planned__label {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .planned__detail {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .foot {
    padding-block: 2rem clamp(3rem, 5vw, 4rem);
  }

  @media (max-width: 820px) {
    .notice {
      grid-template-columns: 1fr;
    }
    .planned__row {
      grid-template-columns: 2.5rem 1fr;
      grid-template-areas:
        'index label'
        'detail detail';
      row-gap: 0.3rem;
    }
    .planned__index {
      grid-area: index;
    }
    .planned__label {
      grid-area: label;
    }
    .planned__detail {
      grid-area: detail;
    }
  }
</style>
