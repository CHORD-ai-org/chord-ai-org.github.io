---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import SplitSection from '../components/SplitSection.astro';
import { site } from '../data/site';

const principles = [
  {
    index: '01',
    title: 'Capability before claim',
    text: 'If something has run once, in one environment, we describe it as an experiment. Words like “solved” and “production-ready” are expensive, and we would rather spend them slowly.',
  },
  {
    index: '02',
    title: 'Extraction over accumulation',
    text: 'Adding another tool to a system is easy. Finding the reusable structure inside a successful run is the work — and it is the only thing that compounds.',
  },
  {
    index: '03',
    title: 'Verifiability over plausibility',
    text: 'An answer that cannot be checked is a draft. Execution should produce something testable, especially when the output looks convincing.',
  },
  {
    index: '04',
    title: 'Public where possible',
    text: 'Open source, published notes, and a community forum are how infrastructure gets corrected by people outside the building.',
  },
];
---

<Base
  title="About"
  description="CHORD is an AI infrastructure company working on what autonomous agents can do — and what has to exist underneath for that work to hold up."
>
  <PageHeader
    eyebrow="Company / 01"
    title="About CHORD"
    lede="An AI infrastructure company working on what autonomous agents can do — and on what has to exist underneath for that work to hold up."
  />

  <div class="shell">
    <SplitSection label="What we are" title="Infrastructure, not a wrapper">
      <p>
        CHORD is an AI infrastructure company. The subject is autonomous agents: what they
        can do, how long they can do it for, and what has to exist underneath so that a
        capability demonstrated once can be used again.
      </p>
      <p>
        That last part is the company. An impressive agent demo is now within reach for
        many teams. Far fewer build the runtime, the abstractions, and the models that make
        the behaviour repeatable by someone who was not present when it first worked.
      </p>
    </SplitSection>

    <SplitSection label="What we build" title="Four products, one direction">
      <p>
        Thylas is the platform people use. WAM is the framework that runs and schedules the
        work. Rym is the model layer being built for the operations WAM needs. Knock is
        where the people doing this — inside and outside CHORD — compare notes.
      </p>
      <p>
        They are at different stages and we label them that way. Rym is a research
        direction. Knock has not opened. Thylas and WAM are the parts of the system that
        exist today.
      </p>
    </SplitSection>

    <SplitSection label="Posture" title="Early, and specific about it">
      <p>
        CHORD is early. This site does not claim customers, revenue, benchmark results, or
        published papers that do not exist. Where something is a research objective it says
        so; where something has been demonstrated, it says that instead.
      </p>
      <p>
        We think this is the more credible position. Infrastructure is judged on whether it
        holds up under real work, and that takes longer than a launch page.
      </p>
    </SplitSection>

    <SplitSection label="Principles" title="Four constraints we hold ourselves to">
      <ol class="principles" role="list">
        {
          principles.map((item) => (
            <li class="principle">
              <span class="principle__index">{item.index}</span>
              <div>
                <h3 class="principle__title">{item.title}</h3>
                <p class="principle__text">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </SplitSection>

    <SplitSection label="Where to find us" title="Public work, public record">
      <p>
        The organization’s public work lives on GitHub. Direct contact channels are listed
        on the <a class="text-link" href="/contact">contact page</a>.
      </p>
      <p>
        <a class="link-arrow" href={site.github} target="_blank" rel="noopener">
          github.com/CHORD-ai-org
          <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path d="M1 5h11M8 1l4 4-4 4" stroke="currentColor" stroke-width="1.4" />
          </svg>
        </a>
      </p>
    </SplitSection>
  </div>
</Base>

<style>
  .principles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .principle {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: var(--hairline);
  }

  .principle:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .principle__index {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    color: var(--terracotta);
    padding-top: 0.35rem;
  }

  .principle__title {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    margin-bottom: 0.3rem;
  }

  .principle__text {
    font-size: 0.9063rem;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 48ch;
  }
</style>
