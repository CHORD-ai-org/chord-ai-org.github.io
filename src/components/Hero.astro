---
import Sigil from './Sigil.astro';
import { products } from '../data/site';
---

<section class="hero">
  <div class="shell hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span>CHORD</span>
        <span class="hero__eyebrow-rule" aria-hidden="true"></span>
        <span>AI Infrastructure</span>
      </p>

      <h1 class="hero__title">
        <span>Expanding</span>
        <span>What Agents</span>
        <span>Can&nbsp;Do<span class="accent">.</span></span>
      </h1>

      <p class="hero__lede">
        We build the infrastructure, models, and computational approaches that enable
        agents to operate beyond conventional boundaries — on research, on products,
        on problems that outlast a single conversation.
      </p>

      <div class="hero__actions">
        <a class="btn btn--solid" href="#products">
          Explore products
          <span class="btn__arrow" aria-hidden="true">↓</span>
        </a>
        <a class="btn" href="/research">
          Explore research
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <figure class="hero__visual">
      <canvas
        class="hero__canvas"
        data-sphere
        role="img"
        aria-label="A rotating particle sphere with construction rings and two orbiting satellites."
      ></canvas>
      <figcaption class="hero__caption">
        <span>Fig. 01</span>
        <span>Particle shell / two construction rings / two orbits</span>
      </figcaption>
    </figure>
  </div>

  <div class="shell">
    <ul class="hero__index" role="list">
      {
        products.map((product) => (
          <li>
            <a href={product.href}>
              <span class="hero__index-sigil">
                <Sigil slug={product.slug} size={20} weight={11} />
              </span>
              <span class="hero__index-name">{product.name}</span>
              <span class="hero__index-category">{product.category}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { mountSphere } from '../scripts/sphere';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-sphere]');
  if (canvas) mountSphere(canvas);
</script>

<style>
  .hero {
    position: relative;
    border-bottom: var(--hairline);
    padding-block: clamp(2.5rem, 5vw, 4.5rem) 0;
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.62fr) minmax(0, 1fr);
    column-gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    min-height: min(78vh, 46rem);
  }

  .hero__copy {
    padding-block: clamp(1rem, 3vw, 3rem);
    position: relative;
    z-index: 2;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--taupe);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__eyebrow-rule {
    width: 2.5rem;
    height: 1px;
    background: var(--terracotta);
  }

  .hero__title {
    font-size: clamp(3rem, 1rem + 7.4vw, 7.25rem);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.05em;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  .hero__title > span {
    display: block;
  }

  .hero__title .accent {
    display: inline;
  }

  .hero__lede {
    max-width: 42ch;
    font-size: clamp(1rem, 0.92rem + 0.35vw, 1.1875rem);
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  .hero__visual {
    align-self: end;
    position: relative;
    margin: 0 calc(var(--gutter) * -0.55) clamp(1.5rem, 4vw, 3rem) 0;
    min-width: 0;
  }

  .hero__canvas {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
  }

  .hero__caption span:first-child {
    white-space: nowrap;
  }

  .hero__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--taupe);
    border-top: 1px solid var(--rule);
    padding-top: 0.6rem;
    margin-top: 0.5rem;
    max-width: 92%;
    margin-left: auto;
  }

  .hero__index {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--hairline);
  }

  .hero__index li {
    border-left: var(--hairline);
  }

  .hero__index li:first-child {
    border-left: 0;
  }

  .hero__index a {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 0.7rem;
    row-gap: 0.15rem;
    padding-block: 1rem 1.15rem;
    padding-inline: clamp(0.75rem, 1.6vw, 1.5rem);
    transition: background-color var(--dur-fast) var(--ease-mechanical);
  }

  .hero__index li:first-child a {
    padding-left: 0;
  }

  .hero__index a:hover {
    background: var(--ivory-raised);
  }

  .hero__index-sigil {
    grid-row: 1 / span 2;
    color: var(--terracotta);
  }

  .hero__index-name {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .hero__index-category {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--taupe);
    line-height: 1.2;
  }

  @media (max-width: 1080px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
    .hero__title {
      font-size: clamp(2.75rem, 7.6vw, 5.5rem);
    }
  }

  @media (max-width: 820px) {
    .hero__inner {
      display: block;
      min-height: 0;
    }
    .hero__copy {
      padding-block: 1.5rem 0.5rem;
    }
    .hero__visual {
      margin: 1.5rem auto 2rem;
      max-width: 30rem;
    }
    .hero__caption {
      max-width: 100%;
    }
    .hero__index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero__index li:nth-child(3) {
      border-left: 0;
    }
    .hero__index li:nth-child(n + 3) {
      border-top: var(--hairline);
    }
    .hero__index li:nth-child(3) a {
      padding-left: 0;
    }
  }
</style>
