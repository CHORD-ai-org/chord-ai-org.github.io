---
export interface Props {
  label: string;
  title?: string;
  id?: string;
}

const { label, title, id } = Astro.props;
---

<section class="split" id={id}>
  <p class="split__label label">{label}</p>
  <div class="split__body">
    {title && <h2 class="split__title">{title}</h2>}
    <div class="split__content"><slot /></div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: 1.25rem;
    padding-block: clamp(2.25rem, 4vw, 3.5rem);
    border-top: var(--hairline);
  }

  .split__label {
    grid-column: 1 / span 2;
    padding-top: 0.45rem;
  }

  .split__body {
    grid-column: 3 / -1;
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: 1.25rem;
  }

  .split__title {
    grid-column: 1 / span 5;
    font-size: clamp(1.5rem, 1.1rem + 1.3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.04;
    max-width: 16ch;
  }

  .split__content {
    grid-column: 6 / -1;
  }

  .split__content :global(p) {
    font-size: 0.9688rem;
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 54ch;
  }

  .split__content :global(p + p) {
    margin-top: 1em;
  }

  @media (max-width: 900px) {
    .split__label {
      grid-column: 1 / -1;
      padding-top: 0;
    }
    .split__body {
      grid-column: 1 / -1;
      display: block;
    }
    .split__title {
      max-width: none;
      margin-bottom: 1rem;
    }
  }
</style>
