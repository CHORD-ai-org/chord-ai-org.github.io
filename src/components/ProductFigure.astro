---
export interface Props {
  slug: 'thylas' | 'wam' | 'rym' | 'knock';
}

const { slug } = Astro.props;
---

<svg
  class="figure"
  viewBox="0 0 640 460"
  role="img"
  aria-label={
    slug === 'thylas'
      ? 'Diagram: a solid sphere above three stacked platform layers with service points and a baseline grid.'
      : slug === 'wam'
        ? 'Diagram: a central Miracle Agent hub connected to tool nodes along a registry arc, above a shared context band.'
        : slug === 'rym'
          ? 'Diagram: a compact core inside concentric rings with four specialized module boundaries.'
          : 'Diagram: a network of connected nodes with one hub, representing the Knock community graph.'
  }
>
  {slug === 'thylas' && (
    <g>
      <g stroke="var(--rule)" stroke-width="1">
        <path d="M40 404 H600" />
        <path d="M80 398 V410 M160 398 V410 M240 398 V410 M320 398 V410 M400 398 V410 M480 398 V410 M560 398 V410" />
      </g>

      <circle cx="320" cy="128" r="50" fill="currentColor" />
      <ellipse cx="320" cy="128" rx="92" ry="24" stroke="currentColor" stroke-width="1" fill="none" />

      <g stroke="currentColor" stroke-width="1.2" fill="none">
        <ellipse cx="320" cy="248" rx="196" ry="48" />
        <ellipse cx="320" cy="308" rx="148" ry="36" />
        <ellipse cx="320" cy="360" rx="98" ry="24" />
      </g>

      <path d="M320 178 V200" stroke="var(--terracotta)" stroke-width="1.4" />
      <path d="M320 200 V388" stroke="var(--terracotta)" stroke-width="1" stroke-dasharray="3 5" />

      <g fill="var(--terracotta)">
        <rect x="118" y="243" width="8" height="8" />
        <rect x="514" y="243" width="8" height="8" />
        <rect x="168" y="304" width="8" height="8" />
        <rect x="464" y="304" width="8" height="8" />
        <rect x="218" y="356" width="8" height="8" />
        <rect x="414" y="356" width="8" height="8" />
      </g>

      <g class="figure__label" fill="var(--taupe)">
        <text x="320" y="72" text-anchor="middle">PACKAGED EXPERIENCE</text>
        <text x="46" y="232">PACKAGED WAM</text>
        <text x="594" y="232" text-anchor="end">KNOWLEDGE LIBRARY</text>
        <text x="320" y="404" text-anchor="middle" fill="var(--ink)">WORKSPACES</text>
      </g>
    </g>
  )}

  {slug === 'wam' && (
    <g>
      <circle cx="320" cy="196" r="128" stroke="var(--rule)" stroke-width="1" stroke-dasharray="2 7" fill="none" />

      <g stroke="currentColor" stroke-width="1.1">
        <path d="M320 196 L320 76" />
        <path d="M320 196 L424 124" />
        <path d="M320 196 L446 208" />
        <path d="M320 196 L392 292" />
        <path d="M320 196 L246 292" />
        <path d="M320 196 L194 208" />
        <path d="M320 196 L216 124" />
      </g>

      <g stroke="currentColor" stroke-width="1.4" fill="var(--ivory)">
        <rect x="314" y="66" width="14" height="14" transform="rotate(45 321 73)" />
        <rect x="418" y="114" width="14" height="14" />
        <rect x="440" y="198" width="14" height="14" />
        <rect x="386" y="282" width="14" height="14" />
        <rect x="240" y="282" width="14" height="14" />
        <rect x="188" y="198" width="14" height="14" />
        <rect x="210" y="114" width="14" height="14" />
      </g>

      <circle cx="320" cy="196" r="36" fill="var(--terracotta)" />
      <path
        d="M268 150 A68 68 0 0 0 258 236"
        stroke="var(--ink)"
        stroke-width="1.4"
        fill="none"
        marker-end="url(#wam-arrow)"
      />
      <defs>
        <marker id="wam-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0 0 L8 4 L0 8 z" fill="var(--ink)" />
        </marker>
      </defs>

      <path d="M320 232 V322" stroke="var(--ink)" stroke-width="1" stroke-dasharray="4 4" />

      <rect x="120" y="322" width="400" height="52" stroke="currentColor" stroke-width="1.4" fill="none" />
      <g stroke="var(--rule)" stroke-width="1">
        <path d="M220 322 V374 M320 322 V374 M420 322 V374" />
      </g>
      <circle cx="138" cy="348" r="4" fill="var(--terracotta)" />

      <g class="figure__label" fill="var(--taupe)">
        <text x="320" y="200" text-anchor="middle" fill="var(--ivory)">MIRACLE</text>
        <text x="320" y="212" text-anchor="middle" fill="var(--ivory)">AGENT</text>
        <text x="320" y="46" text-anchor="middle">TOOL REGISTRY</text>
        <text x="214" y="160" text-anchor="end">DYNAMIC PLANNING</text>
        <text x="120" y="310" fill="var(--ink)">SHARED CONTEXT</text>
        <text x="520" y="310" text-anchor="end">TASK STATE</text>
      </g>
    </g>
  )}

  {slug === 'rym' && (
    <g>
      <rect
        x="118"
        y="86"
        width="404"
        height="292"
        stroke="var(--rule-strong)"
        stroke-width="1"
        stroke-dasharray="4 6"
        fill="none"
      />
      <g fill="currentColor">
        <rect x="156" y="80" width="12" height="12" />
        <rect x="472" y="80" width="12" height="12" />
        <rect x="156" y="372" width="12" height="12" />
        <rect x="472" y="372" width="12" height="12" />
      </g>

      <g stroke="currentColor" fill="none">
        <circle cx="320" cy="232" r="34" stroke-width="1.4" />
        <circle cx="320" cy="232" r="58" stroke-width="1.1" />
        <circle cx="320" cy="232" r="82" stroke-width="0.9" opacity="0.6" />
      </g>

      <g fill="var(--ink)" opacity="0.55">
        <circle cx="320" cy="174" r="2.5" />
        <circle cx="378" cy="232" r="2.5" />
        <circle cx="320" cy="290" r="2.5" />
        <circle cx="262" cy="232" r="2.5" />
        <circle cx="361" cy="191" r="2.5" />
        <circle cx="361" cy="273" r="2.5" />
        <circle cx="279" cy="273" r="2.5" />
        <circle cx="279" cy="191" r="2.5" />
      </g>

      <circle cx="320" cy="232" r="15" fill="var(--terracotta)" />

      <g stroke="var(--ink)" stroke-width="1.2" fill="none">
        <path d="M320 232 H402" />
        <path d="M320 226 V238 M402 226 V238" />
      </g>

      <g fill="none" stroke="currentColor" stroke-width="1.4">
        <rect x="176" y="154" width="26" height="26" />
        <rect x="438" y="154" width="26" height="26" />
        <rect x="176" y="286" width="26" height="26" />
        <rect x="438" y="286" width="26" height="26" />
      </g>
      <g stroke="var(--rule-strong)" stroke-width="1" stroke-dasharray="2 4">
        <path d="M202 167 H262" />
        <path d="M438 167 H378" />
        <path d="M202 299 H262" />
        <path d="M438 299 H378" />
      </g>

      <g class="figure__label" fill="var(--taupe)">
        <text x="320" y="66" text-anchor="middle">ONE SPECIALIZED OPERATION</text>
        <text x="320" y="412" text-anchor="middle" fill="var(--ink)">COMPACT CORE</text>
        <text x="411" y="220">BOUNDARY</text>
      </g>
    </g>
  )}

  {slug === 'knock' && (
    <g>
      <g stroke="var(--rule-strong)" stroke-width="1">
        <path d="M150 120 L246 176 L214 268 L322 232 L404 164 L486 206" />
        <path d="M246 176 L286 96 L404 164 L450 96" />
        <path d="M214 268 L150 340 L262 356 L322 232 L392 348 L450 300" />
        <path d="M486 206 L450 300 L392 348" />
        <path d="M262 356 L286 96" />
      </g>

      <g fill="currentColor">
        <circle cx="150" cy="120" r="5" />
        <circle cx="286" cy="96" r="4" />
        <circle cx="450" cy="96" r="5" />
        <circle cx="486" cy="206" r="4" />
        <circle cx="404" cy="164" r="6" />
        <circle cx="246" cy="176" r="4" />
        <circle cx="214" cy="268" r="5" />
        <circle cx="150" cy="340" r="4" />
        <circle cx="262" cy="356" r="4" />
        <circle cx="392" cy="348" r="5" />
        <circle cx="450" cy="300" r="4" />
      </g>

      <circle cx="322" cy="232" r="16" fill="var(--terracotta)" />
      <circle cx="322" cy="232" r="30" stroke="var(--terracotta)" stroke-width="1" fill="none" opacity="0.5" />

      <g class="figure__label" fill="var(--taupe)">
        <text x="322" y="278" text-anchor="middle">KNOCK</text>
        <text x="404" y="150" text-anchor="middle">DEVELOPERS</text>
        <text x="150" y="104">RESEARCHERS</text>
        <text x="486" y="190">CONTRIBUTORS</text>
        <text x="322" y="412" text-anchor="middle" fill="var(--ink)">LEMMAX INTEGRATION</text>
      </g>
      <path d="M322 296 V392" stroke="var(--terracotta)" stroke-width="1" stroke-dasharray="3 5" />
    </g>
  )}
</svg>

<style>
  .figure {
    width: 100%;
    height: auto;
    color: var(--ink);
    overflow: visible;
  }

  .figure__label text {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 9px;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }
</style>
